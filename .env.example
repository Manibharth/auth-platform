# Copy to .env for local work. Every value here is a FAKE placeholder.
ENVIRONMENT=local
LOG_JSON=true
PUBLIC_BASE_URL=http://localhost:8000
EMAIL_BACKEND=console
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Host ports docker compose publishes. Change one if it is already in use on your machine
# (for example POSTGRES_HOST_PORT=5433 when a local PostgreSQL already owns 5432).
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# APP_HOST_PORT=8000

# DATABASE_URL / REDIS_URL / JWT_PRIVATE_KEY_FILE are set by docker-compose.
# Outside compose:
# DATABASE_URL=postgresql+asyncpg://auth:auth@localhost:5432/auth
# REDIS_URL=redis://localhost:6379/0
# JWT_PRIVATE_KEY_FILE=./secrets/jwt_private.pem

# Seeded by `python -m app.cli seed` (local only — change these).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-passphrase
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=change-me-demo-passphrase

# Optional: TOTP secrets at rest (generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# MFA_ENCRYPTION_KEY=
# Optional: Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/oauth/google/callback
